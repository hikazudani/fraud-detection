        "from pathlib import Path\n",
        "import warnings\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import kagglehub\n",
        "\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import precision_recall_curve, auc, recall_score, precision_score, f1_score\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from lightgbm import LGBMClassifier\n",
        "\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 1. DOWNLOAD E CARREGAMENTO DIRETO VIA KAGGLEHUB\n",
        "# -------------------------------------------------------------------------\n",
        "print(\"Baixando e carregando o dataset PaySim via KaggleHub...\")\n",
        "KAGGLE_DATASET = \"ealaxi/paysim1\"\n",
        "caminho_dataset = Path(kagglehub.dataset_download(KAGGLE_DATASET))\n",
        "\n",
        "arquivos_csv = list(caminho_dataset.rglob(\"*.csv\"))\n",
        "if len(arquivos_csv) == 0:\n",
        "    raise FileNotFoundError(\"Nenhum arquivo CSV encontrado na pasta do KaggleHub.\")\n",
        "\n",
        "dataset_path = arquivos_csv[0]\n",
        "print(f\"Lendo o arquivo: {dataset_path}\")\n",
        "\n",
        "df = pd.read_csv(dataset_path)\n",
        "print(f\"Dimensão original: {df.shape[0]:,} linhas x {df.shape[1]:,} colunas\\n\")\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 2. PRÉ-PROCESSAMENTO E HIGIENIZAÇÃO RIGOROSA DE LEAKAGE\n",
        "# -------------------------------------------------------------------------\n",
        "print(\"Preparando features e aplicando higienização metodológica final...\")\n",
        "\n",
        "# 2.1 Filtrar apenas tipos de transação relevantes para fraude (TRANSFER e CASH_OUT)\n",
        "df_exp = df[df[\"type\"].isin([\"TRANSFER\", \"CASH_OUT\"])].copy()\n",
        "\n",
        "# 2.2 Engenharia de Features Contábeis (Erros Diferenciais)\n",
        "df_exp[\"erro_saldo_origem\"] = df_exp[\"newbalanceOrig\"] + df_exp[\"amount\"] - df_exp[\"oldbalanceOrg\"]\n",
        "df_exp[\"erro_saldo_destino\"] = df_exp[\"oldbalanceDest\"] + df_exp[\"amount\"] - df_exp[\"newbalanceDest\"]\n",
        "\n",
        "# 2.3 Transformação da variável Temporal 'step' em Ciclicidade\n",
        "df_exp[\"hora_dia\"] = df_exp[\"step\"] % 24\n",
        "df_exp[\"dia_semana\"] = (df_exp[\"step\"] // 24) % 7\n",
        "\n",
        "# 2.4 REMOÇÃO DEFINITIVA DE LEAKAGE E SALDOS BRUTOS\n",
        "# - Identificadores/IDs: nameOrig, nameDest, isFlaggedFraud\n",
        "# - Saldos Brutos: velhos e novos saldos (para evitar a regra determinística newbalanceOrig == 0)\n",
        "cols_to_drop = [\n",
        "    \"nameOrig\",\n",
        "    \"nameDest\",\n",
        "    \"isFlaggedFraud\",\n",
        "    \"oldbalanceOrg\",\n",
        "    \"newbalanceOrig\",\n",
        "    \"oldbalanceDest\",\n",
        "    \"newbalanceDest\"\n",
        "]\n",
        "df_exp = df_exp.drop(columns=[c for c in cols_to_drop if c in df_exp.columns])\n",
        "\n",
        "# 2.5 Categorização via One-Hot Encoding para o tipo filtrado\n",
        "df_exp = pd.get_dummies(df_exp, columns=[\"type\"], drop_first=True)\n",
        "\n",
        "# 2.6 Ordenação temporal estrita pelo 'step' original\n",
        "df_exp = df_exp.sort_values(\"step\").reset_index(drop=True)\n",
        "\n",
        "# Definição do Target e Isolamento das Features\n",
        "TARGET = \"isFraud\"\n",
        "IGNORED_COLS = [TARGET, \"step\"]\n",
        "\n",
        "features = [col for col in df_exp.columns if col not in IGNORED_COLS]\n",
        "X = df_exp[features]\n",
        "y = df_exp[TARGET]\n",
        "steps = df_exp[\"step\"]\n",
        "\n",
        "print(f\"Total de registros filtrados (TRANSFER/CASH_OUT): {len(df_exp):,}\")\n",
        "print(f\"Quantidade de Features finais: {len(features)}\")\n",
        "print(f\"Features utilizadas: {features}\")\n",
        "print(f\"Taxa de Fraude no Subset: {y.mean():.4%}\\n\")\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 3. FUNÇÕES AUXILIARES DE AVALIAÇÃO\n",
        "# -------------------------------------------------------------------------\n",
        "def compute_pr_auc(y_true, y_pred_proba):\n",
        "    \"\"\"Calcula a Área Sob a Curva Precision-Recall (PR-AUC).\"\"\"\n",
        "    precision, recall, _ = precision_recall_curve(y_true, y_pred_proba)\n",
        "    return auc(recall, precision)\n",
        "\n",
        "def evaluate_model(model, X_train, y_train, X_test, y_test):\n",
        "    \"\"\"Treina o modelo com padronização e calcula métricas adequadas.\"\"\"\n",
        "    scaler = StandardScaler()\n",
        "    X_tr_scaled = scaler.fit_transform(X_train)\n",
        "    X_te_scaled = scaler.transform(X_test)\n",
        "\n",
        "    model.fit(X_tr_scaled, y_train)\n",
        "\n",
        "    if hasattr(model, \"predict_proba\"):\n",
        "        y_probs = model.predict_proba(X_te_scaled)[:, 1]\n",
        "    else:\n",
        "        y_probs = model.decision_function(X_te_scaled)\n",
        "\n",
        "    y_preds = (y_probs >= 0.5).astype(int)\n",
        "\n",
        "    return {\n",
        "        \"PR_AUC\": compute_pr_auc(y_test, y_probs),\n",
        "        \"Recall\": recall_score(y_test, y_preds, zero_division=0),\n",
        "        \"Precision\": precision_score(y_test, y_preds, zero_division=0),\n",
        "        \"F1_Score\": f1_score(y_test, y_preds, zero_division=0)\n",
        "    }\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 4. VALIDAÇÃO 1: STRATIFIED K-FOLD\n",
        "# -------------------------------------------------------------------------\n",
        "def run_stratified_kfold(X, y, models, n_splits=5):\n",
        "    print(\"[1/2] Executando Stratified K-Fold (Vazamento Temporal)...\")\n",
        "    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)\n",
        "    kfold_results = []\n",
        "\n",
        "    for model_name, model in models.items():\n",
        "        pr_aucs, recalls, precisions, f1s = [], [], [], []\n",
        "\n",
        "        for train_idx, val_idx in skf.split(X, y):\n",
        "            X_tr, y_tr = X.iloc[train_idx], y.iloc[train_idx]\n",
        "            X_val, y_val = X.iloc[val_idx], y.iloc[val_idx]\n",
        "\n",
        "            metrics = evaluate_model(model, X_tr, y_tr, X_val, y_val)\n",
        "\n",
        "            pr_aucs.append(metrics[\"PR_AUC\"])\n",
        "            recalls.append(metrics[\"Recall\"])\n",
        "            precisions.append(metrics[\"Precision\"])\n",
        "            f1s.append(metrics[\"F1_Score\"])\n",
        "\n",
        "        kfold_results.append({\n",
        "            \"Modelo\": model_name,\n",
        "            \"Estratégia\": \"Stratified K-Fold (Leakage)\",\n",
        "            \"PR_AUC\": np.mean(pr_aucs),\n",
        "            \"Recall\": np.mean(recalls),\n",
        "            \"Precision\": np.mean(precisions),\n",
        "            \"F1_Score\": np.mean(f1s)\n",
        "        })\n",
        "        print(f\"  ✓ {model_name} concluído.\")\n",
        "\n",
        "    return pd.DataFrame(kfold_results)\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 5. VALIDAÇÃO 2: OUT-OF-TIME SPLIT\n",
        "# -------------------------------------------------------------------------\n",
        "def run_oot_split(X, y, steps, models, train_ratio=0.8):\n",
        "    print(\"\\n[2/2] Executando Out-Of-Time Split (Validação Temporal Rigorosa)...\")\n",
        "\n",
        "    max_step = steps.max()\n",
        "    split_step = int(max_step * train_ratio)\n",
        "\n",
        "    train_idx = steps <= split_step\n",
        "    test_idx = steps > split_step\n",
        "\n",
        "    X_train, y_train = X[train_idx], y[train_idx]\n",
        "    X_test, y_test = X[test_idx], y[test_idx]\n",
        "\n",
        "    print(f\"  -> Treino: steps 1 a {split_step} ({len(X_train):,} amostras | {y_train.sum():,} fraudes)\")\n",
        "    print(f\"  -> Teste (OOT): steps {split_step + 1} a {max_step} ({len(X_test):,} amostras | {y_test.sum():,} fraudes)\")\n",
        "\n",
        "    oot_results = []\n",
        "\n",
        "    for model_name, model in models.items():\n",
        "        metrics = evaluate_model(model, X_train, y_train, X_test, y_test)\n",
        "\n",
        "        oot_results.append({\n",
        "            \"Modelo\": model_name,\n",
        "            \"Estratégia\": \"Out-Of-Time (Rigoroso)\",\n",
        "            \"PR_AUC\": metrics[\"PR_AUC\"],\n",
        "            \"Recall\": metrics[\"Recall\"],\n",
        "            \"Precision\": metrics[\"Precision\"],\n",
        "            \"F1_Score\": metrics[\"F1_Score\"]\n",
        "        })\n",
        "        print(f\"  ✓ {model_name} concluído.\")\n",
        "\n",
        "    return pd.DataFrame(oot_results)\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 6. EXECUÇÃO E COMPARAÇÃO\n",
        "# -------------------------------------------------------------------------\n",
        "ratio_desbalanceamento = (len(y) - y.sum()) / y.sum()\n",
        "\n",
        "dict_models = {\n",
        "    \"Logistic Regression\": LogisticRegression(\n",
        "        max_iter=1000,\n",
        "        class_weight='balanced',\n",
        "        random_state=42\n",
        "    ),\n",
        "    \"Random Forest\": RandomForestClassifier(\n",
        "        n_estimators=100,\n",
        "        max_depth=10,\n",
        "        random_state=42,\n",
        "        n_jobs=-1\n",
        "    ),\n",
        "    \"LightGBM\": LGBMClassifier(\n",
        "        n_estimators=100,\n",
        "        max_depth=6,\n",
        "        scale_pos_weight=ratio_desbalanceamento,\n",
        "        random_state=42,\n",
        "        n_jobs=-1,\n",
        "        verbose=-1\n",
        "    )\n",
        "}\n",
        "\n",
        "df_kfold = run_stratified_kfold(X, y, dict_models, n_splits=5)\n",
        "df_oot = run_oot_split(X, y, steps, dict_models, train_ratio=0.8)\n",
        "\n",
        "df_resultados = pd.concat([df_kfold, df_oot], ignore_index=True)\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 7. EXIBIÇÃO DOS RESULTADOS E GRÁFICO\n",
        "# -------------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\" COMPARATIVO METODOLÓGICO SANITIZADO: IMPACTO DO VAZAMENTO TEMPORAL\")\n",
        "print(\"=\"*70)\n",
        "print(df_resultados.to_string(index=False))\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "sns.barplot(data=df_resultados, x=\"Modelo\", y=\"PR_AUC\", hue=\"Estratégia\", palette=\"Set2\")\n",
        "plt.title(\"Impacto do Vazamento Temporal na Métrica PR-AUC (Sem Target Leakage)\", fontsize=13, fontweight='bold')\n",
        "plt.ylabel(\"PR-AUC (Quanto maior, melhor)\")\n",
        "plt.ylim(0, 1.05)\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
